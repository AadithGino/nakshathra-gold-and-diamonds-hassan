{
  "name": "@nakshathra/api",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:jest": "jest --config jest.config.cjs --runInBand",
    "test:phase": "npm run test:unit && npm run test:jest",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:jest && npm run build",
    "check": "npm run typecheck && npm run test:unit && npm run test:jest && npm run build",
    "integrity-check": "tsx src/scripts/financial-integrity-check.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:pagination": "tsx src/scripts/seed-pagination.ts",
    "indexes": "tsx src/scripts/sync-indexes.ts",
    "indexes:verify": "tsx src/scripts/verify-indexes.ts",
    "migrate:refund-attempts": "tsx src/scripts/migrations/2026-08-refund-attempts.ts",
    "migrate:payment-accounting-dates": "tsx src/scripts/migrations/2026-08-payment-accounting-dates.ts",
    "migrate:enrollment-plan-snapshots": "tsx src/scripts/migrations/2026-08-enrollment-plan-snapshots.ts",
    "migrate:scheme-operations": "tsx src/scripts/migrations/2026-08-scheme-operations.ts",
    "migrate:nakshathra-domain-config": "tsx src/scripts/migrations/2026-08-nakshathra-domain-config.ts",
    "migrate:nakshathra-scheme-engine": "tsx src/scripts/migrations/2026-08-nakshathra-scheme-engine.ts",
    "migrate:nakshathra-admin-ops": "tsx src/scripts/migrations/2026-08-nakshathra-admin-ops.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.4",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
